{
  "name": "Collect",
  "image": "mcr.microsoft.com/devcontainers/python:3.14",
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "postStartCommand": "nohup python main.py >/tmp/collect.log 2>&1 &",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Collect",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  }
}
